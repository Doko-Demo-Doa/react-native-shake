{
  "name": "react-native-shake",
  "version": "6.11.0",
  "description": "React Native shake event detector",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/module/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./types": "./lib/typescript/module/src/index.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-shake-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "oxlint",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "release": "release-it",
    "format": "oxfmt \"**/*.{js,ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{js,ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doko-Demo-Doa/react-native-shake.git"
  },
  "author": "Quan Pham <doraemonfanclub@gmail.com> (https://github.com/Doko-Demo-Doa)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Doko-Demo-Doa/react-native-shake/issues"
  },
  "homepage": "https://github.com/Doko-Demo-Doa/react-native-shake#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@evilmartians/lefthook": "^2.1.4",
    "@react-native-community/cli": "20.1.3",
    "@react-native/jest-preset": "0.88.0",
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "commitlint": "^21.2.1",
    "del-cli": "^7.0.0",
    "jest": "^29.7.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.41.0",
    "release-it": "^19.2.4",
    "turbo": "^2.8.20",
    "typescript": "^5.8.3"
  },
  "resolutions": {
    "@types/react": "^18.2.44",
    "basic-ftp@^5.0.2": "6.2.3",
    "body-parser@^2.2.2": "2.3.0",
    "glob": "^13.0.0",
    "ajv@^6.12.4": "6.14.0",
    "ajv@^8.11.0": "8.18.0",
    "brace-expansion@1.1.13": "1.1.21",
    "brace-expansion@^1.1.7": "1.1.21",
    "brace-expansion@^5.0.2": "5.0.12",
    "brace-expansion@^5.0.5": "5.0.12",
    "chromium-edge-launcher@^0.2.0": "0.3.0",
    "fast-uri@^3.0.1": "3.1.9",
    "handlebars": "4.7.10",
    "joi@^17.2.1": "17.13.8",
    "js-yaml@4.2.0": "4.3.2",
    "js-yaml@^4.1.0": "4.3.2",
    "js-yaml@^4.1.1": "4.3.2",
    "lodash": "4.18.1",
    "minimatch@^3.0.4": "3.1.5",
    "minimatch@^3.1.2": "3.1.5",
    "minimatch@^10.1.1": "10.2.5",
    "picomatch@^4.0.3": "4.0.4",
    "tar@^7.5.2": "7.5.22",
    "undici": "6.29.1",
    "uuid@^7.0.3": "11.1.1",
    "ws@^7": "7.5.13",
    "ws@^7.5.10": "7.5.13",
    "ws@^8.12.1": "8.21.1",
    "yaml": "2.8.3",
    "js-yaml@^3.13.1": "3.15.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.17.1",
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "codegen",
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNShakeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "ios": {
      "modulesProvider": {
        "RNShake": "RNShake"
      }
    },
    "android": {
      "javaPackageName": "com.shake"
    }
  },
  "create-react-native-library": {
    "type": "module-mixed",
    "languages": "kotlin-objc",
    "version": "0.48.3"
  }
}
